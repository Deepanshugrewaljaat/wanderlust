<% layout('layouts/boilerplate.ejs') -%>

    <h3>Edit existing listing</h3>

    <form method="POST" action="/listing/<%= item._id %>?_method=PUT" novalidate class="needs-validation">

        <label class="form-label">Title</label>
        <input type="text" value="<%= item.title %>" class="form-control mb-3" name="title" required>

        <label class="form-label">Description</label>
        <textarea class="form-control mb-3" name="description" required><%= item.description %></textarea>

        <label class="form-label">Image URL</label>
        <input type="text" value="<%= item.image.url %>" class="form-control mb-3" name="image" required>

        <label class="form-label">Price</label>
        <input type="number" value="<%= item.price %>" class="form-control mb-3" name="price" required>

        <label class="form-label">Location</label>
        <input type="text" value="<%= item.location %>" class="form-control mb-3" name="location" required>

        <label class="form-label">Country</label>
        <input type="text" value="<%= item.country %>" class="form-control mb-3" name="country" required>

        <button type="submit" class="btn btn-primary">Confirm Changes</button>

    </form>