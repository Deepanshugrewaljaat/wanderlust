<% layout('layouts/boilerplate.ejs') -%>

    <h3 class="mb-3">Create a new listing</h3>

    <div class="container">

        <form method="POST" action="/listing" novalidate class="needs-validation">

            <label class="form-label">Title</label>
            <input type="text" name="title" placeholder="Enter a title" class="form-control mb-3" required>
            <div class="valid-feedback">Looks good!</div>
            <div class="invalid-feedback">Please enter a title.</div>

            <label class="form-label">Description</label>
            <textarea name="description" placeholder="Enter a description" class="form-control mb-3"
                required></textarea>
            <div class="valid-feedback">Looks good!</div>
            <div class="invalid-feedback">Please enter a description.</div>

            <label class="form-label">Image URL</label>
            <input type="text" name="image" placeholder="enter url of image" class="form-control mb-3" required>
            <div class="valid-feedback">Looks good!</div>
            <div class="invalid-feedback">Please enter an image URL.</div>

            <label class="form-label">Price</label>
            <input type="number" name="price" placeholder="Enter a price" class="form-control mb-3" required>
            <div class="valid-feedback">Looks good!</div>
            <div class="invalid-feedback">Please enter a valid price.</div>

            <label class="form-label">Location</label>
            <input type="text" name="location" placeholder="Enter a location" class="form-control mb-3" required>
            <div class="valid-feedback">Looks good!</div>
            <div class="invalid-feedback">Please enter a location.</div>

            <label class="form-label">Country</label>
            <input type="text" name="country" placeholder="Enter a country" class="form-control mb-3" required>
            <div class="valid-feedback">Looks good!</div>
            <div class="invalid-feedback">Please enter a country.</div>

            <button class="btn btn-primary">Create</button>

        </form>

    </div>