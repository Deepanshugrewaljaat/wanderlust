<% layout('layouts/boilerplate.ejs') -%>

    <div class="row mt-3">
        <h1 class="">Login </h1>
        <div class="col-6 offset-3">
            <form action="/login" method="POST" >

                <label for="email" class="form-label">Email</label>
                <input id="email" type="email" name="email" placeholder="Enter a email" class="form-control mb-3" required>

                <label class="form-label" for="password">Password</label>
                <input type="password" id="password" name="password" placeholder="Enter a password" class="form-control mb-3" required>

                <button class="btn btn-primary">Login</button>
            </form>
        </div>
    </div>